  "description": "AI-powered Frontend Designer — multi-agent system for generating production-quality websites",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js serve",
    "serve": "tsx src/index.ts serve",
    "dev": "tsx src/index.ts serve",
    "generate": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
